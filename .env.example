# Copy this file to .env and fill in your own local values.
# .env is never committed to Git (see .gitignore) — only this example file is.
# Use clearly fake placeholder values here; never commit real credentials.

# Local MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:your-local-mysql-password@localhost:3306/akmi_untirta_dev"

# Auth.js session encryption secret. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-random-value"
