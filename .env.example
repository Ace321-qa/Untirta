# Copy this file to .env and fill in your own local values.
# .env is never committed to Git (see .gitignore) — only this example file is.
# Use clearly fake placeholder values here; never commit real credentials.

# Public site URL, used to build absolute links in sitemap.xml and social
# share previews (Open Graph). Defaults to http://localhost:3000 if unset —
# update this to the real domain once it's registered (see docs/DECISIONS.md,
# Phase 10 deployment).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:your-local-mysql-password@localhost:3306/akmi_untirta_dev"

# Auth.js session encryption secret. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-random-value"

# Gmail SMTP, used to send a notification email when someone submits the
# contact form (see docs/DECISIONS.md). Optional in development — if left
# unset, the contact form still works and stores messages in the database,
# it just skips sending the notification email (logged as a warning).
# SMTP_USER is your Gmail address; SMTP_PASSWORD is a Gmail "App Password",
# never your real account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-org-gmail@gmail.com"
SMTP_PASSWORD="replace-with-a-gmail-app-password"
CONTACT_TO_EMAIL="humedakmi2026@gmail.com"
