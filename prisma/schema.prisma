// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Roles available at launch. Stored directly on User for now — see
// docs/DECISIONS.md for why we deferred a full Role/Permission table
// system until multiple overlapping staff roles actually need it.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  EVENT_MANAGER
  GALLERY_MANAGER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts     Account[]
  sessions     Session[]
  articles     Article[]
  reportedNews News[]    @relation("NewsReporter")
  editedNews   News[]    @relation("NewsEditor")

  @@map("users")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("article_categories")
}

model ArticleTag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("article_tags")
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.VarChar(500)
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  body          String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage String?
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId   String
  author     User             @relation(fields: [authorId], references: [id])
  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])
  tags       ArticleTag[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("articles")
}

// No ticketing/payment per project scope — registration is just an
// external link (e.g. a Google Form), tracked here only as a URL + quota.
model Event {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  description   String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage String?
  status        ArticleStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime?

  venue   String?
  mapsUrl String?

  organizer            String?
  registrationLink     String?
  registrationDeadline DateTime?
  participantQuota     Int?
  documentUrl          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startAt])
  @@map("events")
}

// Single-row table: the org profile shown on /tentang (Profil, Visi-Misi,
// Nilai-nilai). Always read/written via the fixed id "singleton" — see
// docs/DECISIONS.md for why we didn't build a generic StaticPage system.
model SiteProfile {
  id String @id @default("singleton")

  description String @db.Text
  // Markdown source, rendered safely (no raw HTML) on the public page.
  vision      String @db.Text
  mission     String @db.LongText
  values      String @db.Text

  updatedAt DateTime @updatedAt

  @@map("site_profile")
}

// "Struktur Pengurus" (Management Structure), organized by period so past
// leadership stays on record instead of being overwritten each year.
model ManagementPeriod {
  id        String  @id @default(cuid())
  label     String // e.g. "2025/2026"
  startYear Int
  endYear   Int
  // Only one period should be active at a time (enforced in application
  // code, not the database) — the public page shows the active period by
  // default, with past periods still browsable.
  isActive  Boolean @default(false)

  divisions Division[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("management_periods")
}

model Division {
  id           String           @id @default(cuid())
  periodId     String
  period       ManagementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name         String // e.g. "Pengurus Inti", "Divisi Kaderisasi"
  displayOrder Int              @default(0)

  officers Officer[]

  @@index([periodId])
  @@map("divisions")
}

model Officer {
  id           String   @id @default(cuid())
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name         String
  position     String // e.g. "Ketua Umum", "Anggota"
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  photo        String?
  displayOrder Int      @default(0)

  @@index([divisionId])
  @@map("officers")
}

model BookCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  books Book[]

  @@map("book_categories")
}

// Digital library (Perpustakaan). No file upload yet — fileUrl is a plain
// PDF URL, rendered on the reader page via the browser's built-in PDF
// viewer (an <iframe>), not a third-party flipbook vendor or a new
// dependency like PDF.js. See docs/DECISIONS.md.
model Book {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  author      String
  description String        @db.Text
  coverImage  String?
  fileUrl     String?
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   BookCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@map("books")
}

// A directory listing only — no individual detail pages, per
// docs/FEATURES.md's scope for Layanan ("Services directory").
model Service {
  id           String        @id @default(cuid())
  name         String
  description  String        @db.Text
  // Optional external or internal link (e.g. a WhatsApp number or form).
  link         String?
  status       ArticleStatus @default(DRAFT)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@map("services")
}

enum DayOfWeek {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

// A recurring weekly schedule (e.g. "Kajian Tafsir — Senin, 19:00, Masjid
// Kampus"), distinct from Kegiatan/Event which covers one-off activities
// with their own specific date. Rendered as a list grouped by day, not a
// full month calendar grid — see docs/DECISIONS.md.
model ScheduleItem {
  id           String        @id @default(cuid())
  title        String
  dayOfWeek    DayOfWeek
  // Plain "HH:MM" strings rather than a Time/DateTime column — this is a
  // recurring weekly slot, not tied to any specific calendar date.
  startTime    String
  endTime      String?
  location     String?
  description  String?       @db.Text
  status       ArticleStatus @default(DRAFT)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, dayOfWeek])
  @@map("schedule_items")
}

// Organizational accountability reports (Laporan Pertanggungjawaban /
// annual reports), published as downloadable documents. See
// docs/FEATURES.md's note on this being an assumption, confirmed as a
// DECISION when this module was built — see docs/DECISIONS.md.
model Report {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  year        Int
  fileUrl     String?
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, year])
  @@map("reports")
}

// Submissions from the public "Hubungi Kami" contact form. A notification
// email is sent on submission (best-effort — see docs/DECISIONS.md), but
// this table is the source of truth so no message is ever lost if email
// delivery fails.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  eventDate   DateTime?
  coverImage  String?
  // Optional external video (e.g. a YouTube link) shown alongside photos.
  videoUrl    String?
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images GalleryImage[]

  @@index([status, eventDate])
  @@map("gallery_albums")
}

model GalleryImage {
  id                 String       @id @default(cuid())
  albumId            String
  album              GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url                String
  // Required, not optional — accessibility requirement (every image needs
  // meaningful alt text, per docs/PROJECT-VISION.md's accessibility goals).
  altText            String
  caption            String?
  photographerCredit String?
  displayOrder       Int          @default(0)
  createdAt          DateTime     @default(now())

  @@index([albumId])
  @@map("gallery_images")
}

model NewsCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique
  news News[]

  @@map("news_categories")
}

model News {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  excerpt           String?       @db.VarChar(500)
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  body              String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage     String?
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  // News-specific fields (what distinguishes News from Articles).
  eventDate         DateTime?
  location          String?
  sourceAttribution String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reporterId String
  reporter   User          @relation("NewsReporter", fields: [reporterId], references: [id])
  editorId   String?
  editor     User?         @relation("NewsEditor", fields: [editorId], references: [id])
  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id])

  @@index([reporterId])
  @@index([editorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("news")
}

// Auth.js (Phase 5) needs Account/Session/VerificationToken in this shape.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
