// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Roles available at launch. Stored directly on User for now — see
// docs/DECISIONS.md for why we deferred a full Role/Permission table
// system until multiple overlapping staff roles actually need it.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  EVENT_MANAGER
  GALLERY_MANAGER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts     Account[]
  sessions     Session[]
  articles     Article[]
  reportedNews News[]    @relation("NewsReporter")
  editedNews   News[]    @relation("NewsEditor")

  @@map("users")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("article_categories")
}

model ArticleTag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("article_tags")
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.VarChar(500)
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  body          String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage String?
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId   String
  author     User             @relation(fields: [authorId], references: [id])
  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])
  tags       ArticleTag[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("articles")
}

// No ticketing/payment per project scope — registration is just an
// external link (e.g. a Google Form), tracked here only as a URL + quota.
model Event {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  description   String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage String?
  status        ArticleStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime?

  venue   String?
  mapsUrl String?

  organizer            String?
  registrationLink     String?
  registrationDeadline DateTime?
  participantQuota     Int?
  documentUrl          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startAt])
  @@map("events")
}

// Single-row table: the org profile shown on /tentang (Profil, Visi-Misi,
// Nilai-nilai). Always read/written via the fixed id "singleton" — see
// docs/DECISIONS.md for why we didn't build a generic StaticPage system.
model SiteProfile {
  id String @id @default("singleton")

  description String @db.Text
  // Markdown source, rendered safely (no raw HTML) on the public page.
  vision      String @db.Text
  mission     String @db.LongText
  values      String @db.Text

  updatedAt DateTime @updatedAt

  @@map("site_profile")
}

model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  eventDate   DateTime?
  coverImage  String?
  // Optional external video (e.g. a YouTube link) shown alongside photos.
  videoUrl    String?
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images GalleryImage[]

  @@index([status, eventDate])
  @@map("gallery_albums")
}

model GalleryImage {
  id                 String       @id @default(cuid())
  albumId            String
  album              GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url                String
  // Required, not optional — accessibility requirement (every image needs
  // meaningful alt text, per docs/PROJECT-VISION.md's accessibility goals).
  altText            String
  caption            String?
  photographerCredit String?
  displayOrder       Int          @default(0)
  createdAt          DateTime     @default(now())

  @@index([albumId])
  @@map("gallery_images")
}

model NewsCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique
  news News[]

  @@map("news_categories")
}

model News {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  excerpt           String?       @db.VarChar(500)
  // Markdown source, rendered safely (no raw HTML) on the public pages.
  body              String        @db.LongText
  // Plain image URL for now — real file upload comes with the dedicated
  // media-handling feature later. See docs/DECISIONS.md.
  featuredImage     String?
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  // News-specific fields (what distinguishes News from Articles).
  eventDate         DateTime?
  location          String?
  sourceAttribution String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reporterId String
  reporter   User          @relation("NewsReporter", fields: [reporterId], references: [id])
  editorId   String?
  editor     User?         @relation("NewsEditor", fields: [editorId], references: [id])
  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id])

  @@index([reporterId])
  @@index([editorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("news")
}

// Auth.js (Phase 5) needs Account/Session/VerificationToken in this shape.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
